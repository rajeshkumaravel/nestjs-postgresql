
# ==========================================
# Database Configuration
# ==========================================

# Option 1: Local system PostgreSQL
DATABASE_URL="postgresql://postgres:YOUR_LOCAL_PASSWORD@localhost:5432/interview_poc?schema=public"

# Option 2: Supabase PostgreSQL
# Comment out the local URL above and uncomment this URL.
# Use the connection details from your Supabase Dashboard.
# DATABASE_URL="postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@YOUR_SUPABASE_POOLER_HOST:5432/postgres"

# ==========================================
# JWT Authentication
# ==========================================

# Generate a unique, strong secret for your environment.
JWT_SECRET="replace-with-a-strong-random-secret"

# Token expiration duration (e.g. 15m, 1h, 1d)
JWT_EXPIRES_IN="15m"
